<Project Sdk="Microsoft.Build.Sql/1.0.0">
  <PropertyGroup><TargetFramework>net8.0</TargetFramework><SqlServerVersion>Sql160</SqlServerVersion><DSP>Microsoft.Data.Tools.Schema.Sql.Sql160DatabaseSchemaProvider</DSP><UseTaskHostFactory>false</UseTaskHostFactory><NoWarn>$(NoWarn);CA1016</NoWarn></PropertyGroup>
  <ItemGroup>
    <Build Remove="SeedData\SupplierPaymentTerms.sql"/><Build Remove="SeedData\CustomerPaymentTerms.sql"/><Build Remove="SeedData\WarehouseTypes.sql"/><Build Remove="SeedData\InventorySettings.sql"/><Build Remove="SeedData\PaymentMethods.sql"/><Build Remove="SeedData\InvoiceSeries.sql"/><Build Remove="SeedData\PurchaseSeries.sql"/><Build Remove="SeedData\DemoData.sql"/>
    <Build Remove="Scripts\VerifyPOS.sql"/><Build Remove="Scripts\VerifyPurchase.sql"/><Build Remove="Scripts\V1_ReleaseHardening.sql"/>
    <Build Remove="Scripts\RCDEV008-RuntimeObjects.sql"/>
    <Build Remove="Scripts\RCDEV009-PrintingPaperSize.sql"/>
    <None Include="SeedData\DemoData.sql"/><None Include="Scripts\VerifyPOS.sql"/><None Include="Scripts\VerifyPurchase.sql"/><None Include="Scripts\V1_ReleaseHardening.sql"/>
    <None Include="Scripts\RCDEV008-RuntimeObjects.sql"/>
    <None Include="Scripts\RCDEV009-PrintingPaperSize.sql"/>
    <PostDeploy Include="Scripts\PostDeployment.sql"/>
  </ItemGroup>
</Project>
