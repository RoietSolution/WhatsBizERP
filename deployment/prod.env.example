# Template only. Install as root-owned /etc/whatsbiz/prod.env with mode 0640.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5002
App__PublicBaseUrl=https://api.khatadhari.com
WhatsApp__PublicBaseUrl=https://api.khatadhari.com
AllowedHosts=api.khatadhari.com
Cors__AllowedOriginsCsv=https://app.khatadhari.com

# Must target exactly WhatsBizERP_PROD. Never use a QA or development connection.
ConnectionStrings__DefaultConnection=<PRODUCTION_SQL_CONNECTION_STRING_FOR_WhatsBizERP_PROD>
Jwt__SigningKey=<RANDOM_PRODUCTION_SIGNING_KEY_AT_LEAST_32_CHARACTERS>

# Bootstrap only if an ApplicationOwner must be created. Supply a strong one-time
# password out-of-band, start once, then disable bootstrap and remove the password.
IdentityBootstrap__ApplicationOwner__Enabled=false
IdentityBootstrap__ApplicationOwner__Username=<PRODUCTION_OWNER_USERNAME>
IdentityBootstrap__ApplicationOwner__Email=<PRODUCTION_OWNER_EMAIL>
IdentityBootstrap__ApplicationOwner__Password=<ONE_TIME_STRONG_OWNER_PASSWORD>
IdentityBootstrap__ApplicationOwner__ResetPasswordOnStart=false

ProductImageStorage__Provider=S3
ProductImageStorage__S3__BucketName=khatadhari-whatsbiz-prod
ProductImageStorage__S3__Region=ap-south-1
# Prefer the server's scoped IAM role. Set both keys only if that is unavailable.
ProductImageStorage__S3__AccessKey=
ProductImageStorage__S3__SecretKey=

# Set enablement and SMTP values only if production email is intended.
DemoRequests__Email__Enabled=false
DemoRequests__Email__Host=<SMTP_HOST>
DemoRequests__Email__Port=587
DemoRequests__Email__EnableSsl=true
DemoRequests__Email__Username=<SMTP_USERNAME>
DemoRequests__Email__Password=<SMTP_PASSWORD>
DemoRequests__Email__FromAddress=<VERIFIED_FROM_ADDRESS>
DemoRequests__Email__FromName=KhataDhari Website
DemoRequests__Email__SupportAddress=<SUPPORT_ADDRESS>
PasswordReset__FrontendBaseUrl=https://app.khatadhari.com
PasswordReset__TokenLifespanMinutes=60

Security__DataProtection__ApplicationName=WhatsBizERP-Production
Security__DataProtection__KeyRingPath=/var/lib/whatsbiz-prod/dataprotection-keys

# Platform App ID, App Secret, and webhook verify token are provisioned through
# /admin/whatsapp-platform and stored protected in WhatsBizERP_PROD. Never add them here.
WhatsApp__Meta__EmbeddedSignupConfigurationId=<PRODUCTION_EMBEDDED_SIGNUP_CONFIGURATION_ID>
WhatsApp__Meta__GraphBaseUrl=https://graph.facebook.com
WhatsApp__Meta__GraphApiVersion=v23.0

# Keep online payments disabled / in existing approved mode for the COD pilot.
# Configure Razorpay secrets only for a separately approved payment rollout.
