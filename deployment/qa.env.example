# Copy to /etc/whatsbiz/qa.env on the server. Never commit the real file.
ASPNETCORE_ENVIRONMENT=QA
ASPNETCORE_URLS=http://127.0.0.1:5001

App__PublicBaseUrl=https://qa-api.khatadhari.com
WhatsApp__PublicBaseUrl=https://qa-api.khatadhari.com
AllowedHosts=qa-api.khatadhari.com
Cors__AllowedOriginsCsv=https://qa.khatadhari.com

ConnectionStrings__DefaultConnection=<QA_SQL_CONNECTION_STRING>
Jwt__SigningKey=<RANDOM_JWT_SIGNING_KEY_AT_LEAST_32_CHARACTERS>

# Enable only for the initial administrator creation (or an intentional one-time reset).
# After a successful start, set Enabled=false, remove Password, and keep ResetPasswordOnStart=false.
IdentityBootstrap__Administrator__Enabled=false
IdentityBootstrap__Administrator__TenantKey=QA_DEFAULT
IdentityBootstrap__Administrator__Username=qa.admin
IdentityBootstrap__Administrator__Email=qa.admin@khatadhari.com
IdentityBootstrap__Administrator__Password=<ONE_TIME_STRONG_ADMIN_PASSWORD>
IdentityBootstrap__Administrator__IncludeSystemAdministratorRole=true
IdentityBootstrap__Administrator__ResetPasswordOnStart=false

ProductImageStorage__Provider=S3
ProductImageStorage__S3__BucketName=khatadhari-whatsbiz-qa
ProductImageStorage__S3__Region=ap-south-1
ProductImageStorage__S3__AccessKey=<AWS_ACCESS_KEY>
ProductImageStorage__S3__SecretKey=<AWS_SECRET_KEY>

DemoRequests__Email__Enabled=true
DemoRequests__Email__Host=<SMTP_HOST>
DemoRequests__Email__Port=587
DemoRequests__Email__EnableSsl=true
DemoRequests__Email__Username=<SMTP_USERNAME>
DemoRequests__Email__Password=<SMTP_PASSWORD>
DemoRequests__Email__FromAddress=<FROM_ADDRESS>
DemoRequests__Email__FromName=KhataDhari Website
DemoRequests__Email__SupportAddress=<SUPPORT_ADDRESS>
DemoRequests__WhatsAppContactNumber=<CONTACT_NUMBER>

# The key ring must be persistent and private or saved Meta secrets cannot be decrypted after a redeploy.
Security__DataProtection__ApplicationName=WhatsBizERP-QA
Security__DataProtection__KeyRingPath=/var/lib/whatsbiz-qa/data-protection-keys

# Optional only when these features are enabled.
# DemoRequests__Captcha__SiteKey=<CAPTCHA_SITE_KEY>
# DemoRequests__Captcha__SecretKey=<CAPTCHA_SECRET_KEY>
# Razorpay__KeyId=<RAZORPAY_KEY_ID>
# Razorpay__KeySecret=<RAZORPAY_KEY_SECRET>
# Razorpay__WebhookSecret=<RAZORPAY_WEBHOOK_SECRET>
